{% extends 'base.html.twig' %}

{% block title %}Hello PageController!{% endblock %}

{% block body %}


<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Découvrez notre boutique en ligne spécialisée dans les vêtements de sport. Retrouvez une sélection de tenues et équipements sportifs adaptés à vos besoins.">
    <title>Projet fin</title>
</head>
<body>
    
    <!-- Homepage -->
    <main class="relative flex min-h-screen w-[402px] flex-col items-center gap-[25px] overflow-y-scroll  pt-[44px] pb-[8px]  min-[700px]:text-lg">
        
    <!-- Header -->
    <header class="box-border flex h-[87px] w-[358.25px] flex-row items-center justify-center gap-[41px] border border-white px-4">

        <!-- Menu icon -->
        <button class="h-[47.86px] w-[56px]">
            <span class="block border-[4px] border-[#326DE2]"></span>
        </button>

        <!-- Logo -->
        <div class="h-[87px] w-[97px]">
             <h1>test</h1>
             <img src="https://unsplash.it/100/100" alt="Image simple" >
        </div>

        <!-- User and cart icons -->
        <div class="flex h-[43.93px] w-[91.25px] items-center gap-0">
            <button class="h-[40px] w-[40px]">
                <!-- User icon -->
            </button>

            <button class="h-[40px] w-[50px]">
                <!-- Shopping cart icon -->
            </button>
        </div>

    </header>


    <!-- Search bar -->
    <div class="box-border flex h-[50px] w-[350px] items-center gap-[21px] rounded-[50px] border border-white bg-[#F5F5F5] px-4">

        <!-- Search icon -->
        <div class="h-[32px] w-[32px]">
            <!-- Search icon -->
        </div>

        <!-- Search title -->
        <input
            type="text"
            placeholder="Rechercher..."
            class="h-[28px] w-[156px] bg-transparent font-['Inter'] text-[24px] font-normal leading-[29px] text-[#D9D9D9] outline-none placeholder:text-[#D9D9D9]"
        >

    </div>


    <!-- Homepage suggestions -->
    <section class="box-border flex h-[60px] w-[402px] flex-col items-start gap-[10px] overflow-x-auto border border-[#F5F5F5] px-[5px] py-[10px]">
        
        <div class="flex h-[37px] w-max items-start gap-[10px]">
            
            <button class="flex h-[37px] w-[89px] items-center justify-center border border-black bg-white px-[13px] py-[10px] text-center text-[12px]">
                CLICK ME
            </button>
            
            
        </div>
    </section>
    
    
    <!-- Product catalogue -->
    <section class="flex w-[336px] flex-col items-end gap-[26px]">
        
        <!-- Product 1 -->
        <article class="flex w-[334px] flex-col items-start gap-[11px] bg-white">

            <img
                src="nike-tn-bleu.png"
                alt="Nike TN bleu"
                class="h-[334px] w-[334px] object-cover shadow-[0_0_50px_2px_rgba(80,80,80,0.2)]"
            >


        </body>
        </html>
        <!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Accept a payment</title>
    <meta name="description" content="A demo of a payment on Stripe" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="checkout.css" />
    <script src="https://js.stripe.com/dahlia/stripe.js"></script>
    <script src="checkout.js" defer></script>
  </head>
  <body>
    <!-- Display a payment form -->
    <form id="payment-form">
      <div id="contact-details-element">
        <!--Stripe.js injects the Contact Details Element-->
      </div>
      <h4>Payment</h4>
      <div id="payment-element">
        <!--Stripe.js injects the Payment Element-->
      </div>
      <button id="submit">
        <div class="spinner hidden" id="spinner"></div>
        <span id="button-text">Pay now</span>
      </button>
      <div id="payment-message" class="hidden"></div>
    </form>
  </body>
</html>

{% endblock %}
